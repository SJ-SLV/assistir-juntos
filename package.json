{
  "name": "2-on-platform",
  "version": "2.3.0",
  "private": true,
  "description": "2 ON — plataforma de jogos competitivos em tempo real, com campeonatos, espectadores, chat e voz.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check public/games.js",
    "test": "npm run check && npm run test:static",
    "test:static": "node scripts/smoke.js",
    "test:e2e": "node scripts/e2e-championship.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.0",
    "qrcode": "1.5.1"
  }
}
