{
  "name": "2-on-platform",
  "version": "1.9.0",
  "private": true,
  "description": "2 ON — plataforma unificada para jogar, competir e assistir juntos.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
